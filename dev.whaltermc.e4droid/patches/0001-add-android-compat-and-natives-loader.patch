+package dev.whaltermc.e4droid;
+
+/**
+ * Android (PojavLauncher) detection and helpers for e4droid.
+ *
+ * All Android-specific code lives outside the upstream {@code link.e4mc}
+ * namespace, in {@code dev.whaltermc.e4droid}.
+ */
+public final class AndroidCompat {
+    private static final boolean ANDROID = detectAndroid();
+
+    private AndroidCompat() {
+    }
+
+    public static boolean isAndroid() {
+        return ANDROID;
+    }
+
+    /** ABI folder name used when resolving Android natives. */
+    public static String abi() {
+        String arch = System.getProperty("os.arch", "").toLowerCase();
+        return switch (arch) {
+            case "aarch64", "arm64" -> "arm64-v8a";
+            case "arm", "armv7l", "armeabi-v7a" -> "armeabi-v7a";
+            case "x86_64", "amd64" -> "x86_64";
+            case "x86", "i386", "i486", "i586", "i686" -> "x86";
+            default -> arch;
+        };
+    }
+
+    private static boolean detectAndroid() {
+        if (System.getProperty("e4droid.forceAndroid") != null) {
+            return true;
+        }
+        if (System.getProperty("android.runtime") != null
+                || System.getProperty("android.vm.name") != null
+                || System.getProperty("java.runtime.name", "").toLowerCase().contains("android")) {
+            return true;
+        }
+        try {
+            Class.forName("android.os.Build");
+            return true;
+        } catch (ClassNotFoundException ignored) {
+        }
+        String vendor = System.getProperty("java.vendor", "").toLowerCase();
+        String osName = System.getProperty("os.name", "").toLowerCase();
+        return vendor.contains("android") || osName.contains("android");
+    }
+}
diff --git a/common/src/main/java/dev/whaltermc/e4droid/AndroidNatives.java b/common/src/main/java/dev/whaltermc/e4droid/AndroidNatives.java
